{
  "name": "instagram-to-order",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/tool.mjs wrangler dev --config wrangler.worker.jsonc --port 8787",
    "dev:web": "vite --host 0.0.0.0",
    "db:local": "node scripts/tool.mjs wrangler d1 migrations apply orders-db --local",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:api": "node scripts/api-smoke.mjs",
    "test:e2e": "node scripts/tool.mjs playwright test",
    "preview": "node scripts/tool.mjs wrangler dev --config wrangler.worker.jsonc --port 8787",
    "admin:create": "node scripts/create-admin.mjs",
    "deploy": "npm run build && node scripts/tool.mjs wrangler deploy --config wrangler.worker.jsonc",
    "deploy:pages": "npm run build && node scripts/tool.mjs wrangler pages deploy dist",
    "preview:pages": "node scripts/tool.mjs wrangler pages dev dist --port 8788",
    "setup": "node scripts/local-config.mjs && npm run build && npm run db:local"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.43.0"
  },
  "engines": {
    "node": ">=22.14"
  }
}
